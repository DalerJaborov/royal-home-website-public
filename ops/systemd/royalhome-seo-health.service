[Unit]
Description=Read-only origin ROYAL HOME SEO crawl (external browser checks separate)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/royalhome-site
ExecStart=/usr/bin/bash /opt/royalhome-site/ops/seo-health.sh
TimeoutStartSec=20min
Nice=10
