{
  "name": "royal-home-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build -c vite.build.config.ts --configLoader runner && npm run build:ssr && npm run build:server && npm run build:tools",
    "build:ssr": "vite build -c vite.ssr.config.ts --configLoader runner",
    "build:server": "esbuild api/boot.ts --bundle --platform=node --format=esm --packages=external --alias:@db=./db --alias:@contracts=./contracts --outfile=dist/boot.js",
    "build:tools": "esbuild api/tools/draw-covers.ts api/tools/fix-voice.ts api/tools/write-article.ts api/tools/refresh-articles.ts --bundle --platform=node --format=esm --packages=external --alias:@db=./db --alias:@contracts=./contracts --outdir=dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "NODE_ENV=production node dist/boot.js",
    "check": "tsc -b",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:lead-outbox": "esbuild ops/test-lead-outbox.ts --bundle --platform=node --format=esm --packages=external --alias:@db=./db --alias:@contracts=./contracts --outfile=dist/test-lead-outbox.mjs && node dist/test-lead-outbox.mjs",
    "test:crm-facts": "esbuild ops/test-crm-listing-facts.ts --bundle --platform=node --format=esm --packages=external --alias:@db=./db --alias:@contracts=./contracts --outfile=dist/test-crm-listing-facts.mjs && node dist/test-crm-listing-facts.mjs",
    "check:seo": "node scripts/check-public-seo.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.965.0",
    "@aws-sdk/s3-request-presigner": "^3.965.0",
    "@hono/node-server": "^2.1.5",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
