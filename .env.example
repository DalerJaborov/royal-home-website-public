# ── Required ─────────────────────────────────────────────────────
APP_SECRET=               # Any long random string — used to sign admin login sessions
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Admin login (creates/updates the one admin account on server start) ──
ADMIN_EMAIL=              # e.g. admin@royalhome.tj
ADMIN_PASSWORD=           # set this, log in once, then you may remove it from the host's env vars

# ── Optional ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=        # enables Claude-powered listing descriptions in the admin
                          # (without it a built-in template generator is used instead)

# Лента Instagram на главной берётся из CRM (см. api/instagram-router.ts): маркер
# Instagram живёт ТОЛЬКО в Настройках CRM, там же продлевается по расписанию. Свой
# маркер сайту больше не нужен — два маркера на один аккаунт гасили друг друга, и
# лента пропадала после каждой генерации нового. Адрес CRM берётся из CRM_LEAD_URL
# ниже; переменная нужна, только если CRM переедет на другой хост.
CRM_INSTAGRAM_URL=        # напр. https://crm.royalhome.tj/api/v1/public/instagram/media
                          # Без доступной CRM секция работает на обложках из
                          # admin → Настройки сайта → Instagram/Reels.

# ── Gemini через прокси (статьи блога и картинки к ним) ─────────
# Google не обслуживает регион нашего сервера: прямой запрос получает 400
# «User location is not supported for the API use» — при исправном ключе. Обходим
# тем же Cloudflare Worker, что проксирует Instagram (маршрут /gemini/*).
# Значения — те же, что в .env.production CRM. Без них Gemini на боевом сервере
# не работает вовсе; на своей машине можно не задавать (пойдём напрямую).
# Ключ самого Gemini живёт в админке (Блог → Ключ Gemini API), а не здесь.
# ВНИМАНИЕ: рисование обложек требует ключа Gemini с подключённой оплатой —
# на бесплатном тарифе квота image-моделей равна нулю (ответ 429 «limit: 0»).
GEMINI_PROXY_URL=         # напр. https://<имя>.workers.dev
GEMINI_PROXY_KEY=         # значение заголовка x-proxy-key

# ── Google Sheets import/export (admin → Объекты → Импорт/Экспорт) ──
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=  # base64 of the service-account JSON key (Google Cloud
                                     # Console → IAM → Service Accounts → Keys). Share the
                                     # target spreadsheet with the service account's
                                     # client_email as an Editor for this to work.
GOOGLE_SHEETS_ID=                   # the spreadsheet ID from its URL
                                     # (.../spreadsheets/d/<THIS PART>/edit)

# ── reCAPTCHA v3 (invisible spam check on lead forms) ───────────
VITE_RECAPTCHA_SITE_KEY=  # public — from google.com/recaptcha admin console
RECAPTCHA_SECRET_KEY=     # secret — same console, server-side only, never expose
                          # Without these, forms still work — protected only by
                          # the honeypot + fast-submit check in lead-router.ts.

# ── CRM integration (see D:\CRM, DEPLOY.md §5) ──────────────────
CRM_LEAD_URL=              # e.g. https://crm.royalhome.tj/api/v1/webhooks/website-lead
CRM_LEAD_API_KEY=          # same value as WEBSITE_LEAD_API_KEY in the CRM's apps/api/.env
                          # Without these, leads are only saved locally (admin → Заявки) —
                          # the site never fails or blocks a submission either way.

CRM_NOTIFY_URL=            # e.g. https://crm.royalhome.tj/api/v1/webhooks/site-listing-changed
                          # Notifies the CRM when an admin edits/deletes a listing that was
                          # synced FROM the CRM (externalId set — see api/lib/notifyCrm.ts).
                          # Reuses CRM_LEAD_API_KEY above, no separate secret. Without this,
                          # the admin panel can still edit/delete those listings — the CRM
                          # just never finds out.

# CRM → site listing sync (publish/unpublish/sold buttons in the CRM, see
# ops/CRM_SYNC_PLAN.md). Same value as SITE_SYNC_API_KEY in the CRM's
# apps/api/.env. Empty = POST /api/v1/crm/listings returns 503, CRM-side sync
# just reports the failure — nothing else on the site is affected.
CRM_SYNC_API_KEY=

# Separate, higher-privilege key for the emergency admin-password-reset
# webhook (POST /admin-reset — hands back the admin password in plaintext and
# can strip 2FA). Deliberately NOT the same value as CRM_SYNC_API_KEY above:
# that key is also used for routine listing/lead-status sync, so a leak there
# must not also unlock full admin takeover. Same value as
# SITE_SYNC_ADMIN_RESET_KEY in the CRM's apps/api/.env. Empty = the reset
# webhook returns 503 — the CRM-side "Аварийный сброс" button just reports
# the channel as unconfigured, nothing else on the site is affected.
CRM_SYNC_ADMIN_RESET_KEY=

# ── Not used for the standalone deploy — only relevant if re-integrating
#    with the Kimi platform's own OAuth login. Safe to leave blank. ──
APP_ID=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
OWNER_UNION_ID=
VITE_KIMI_AUTH_URL=
VITE_APP_ID=

# ── Hosting note ─────────────────────────────────────────────────
# Uploaded photos (agent/listing images) are written to an ./uploads
# folder next to the app and served from /api/uploads/*. This needs a
# host with a persistent disk (a VPS, or a PaaS with a mounted volume) —
# on hosts with an ephemeral filesystem (ships a fresh container per
# deploy/restart), uploaded photos would be lost. Confirm this before
# picking a host.

# ── Meta Pixel + Conversions API (docs/meta-pixel.md) ───────────
META_PIXEL_ID=            # public, digits only (Events Manager → Data sources → Pixel ID).
                          # EMPTY = integration fully off: no script in the HTML, no Facebook hosts
                          # in the CSP, zero requests to Meta. Safe default until the pixel exists.
META_CAPI_TOKEN=          # SECRET, server-only (Events Manager → Settings → Conversions API →
                          # Generate access token). Never sent to the browser, never logged.
                          # Without it only the browser pixel works (no server events).
META_CAPI_TEST_EVENT_CODE=  # optional "TEST12345" from Events Manager → Test events; events then show
                          # up only in that tab. Leave EMPTY in production.
